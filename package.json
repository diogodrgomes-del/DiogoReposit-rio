{
  "name": "mark-sistem",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mark/web",
    "build": "npm run build --workspace=@mark/web",
    "lint": "eslint .",
    "tipos": "tsc --build --verbose",
    "teste": "vitest run",
    "teste:observar": "vitest",
    "db:gerar": "npm run gerar --workspace=@mark/db",
    "db:migrar": "npm run migrar --workspace=@mark/db",
    "db:semear": "npm run semear --workspace=@mark/db",
    "worker": "npm run dev --workspace=@mark/worker",
    "db:importar-meta": "npm run importar-meta --workspace=@mark/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
