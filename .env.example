# ============================================================
# MARK SISTEM — variáveis de ambiente
#
# Copie para .env no seu computador e cadastre os mesmos valores
# em Settings → Environment Variables na Vercel.
#
# NENHUMA destas variáveis chega ao navegador: todas são lidas só
# no servidor. Não use o prefixo NEXT_PUBLIC_ em nenhuma — esse
# prefixo publicaria o valor no pacote que vai para o navegador.
# ============================================================

# ── Obrigatórias ────────────────────────────────────────────

# PostgreSQL 16+. Local, Neon, Supabase, RDS — qualquer um serve.
#   local:  postgresql://mark:mark@127.0.0.1:5432/marksistem
#   Neon:   postgresql://user:senha@ep-xxx.neon.tech/db?sslmode=require
DATABASE_URL=

# Conexão SEM pooler. Na Vercel o app usa o pooler (DATABASE_URL), mas as
# migrations precisam de conexão direta — PgBouncer em modo transação não
# suporta os comandos que o Prisma Migrate emite. Sem pooler, repita o
# mesmo valor de DATABASE_URL aqui.
DIRECT_URL=

# ── Primeiro acesso (só no seed) ────────────────────────────
# Usadas uma única vez por `npm run db:seed`, para criar o proprietário.
# Sem SEED_SENHA, o seed pergunta no terminal; sem terminal, gera uma
# senha aleatória e a imprime uma vez só.
SEED_EMAIL=voce@suaempresa.com.br
SEED_NOME=Seu Nome
SEED_SENHA=

# Preencha com 1 para criar clientes, leads, demandas e lançamentos de
# exemplo. Útil para conhecer o sistema; deixe vazio em produção.
SEED_EXEMPLOS=

# ── Cofre de credenciais (módulo Senhas) ────────────────────
# Chave mestra da criptografia em envelope. 32 bytes em base64.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# ATENÇÃO: perdida esta chave, as senhas guardadas são irrecuperáveis —
# inclusive do backup, que guarda apenas texto cifrado. Mantenha cópia
# em pelo menos dois lugares fora do servidor.
CREDENTIALS_MASTER_KEY=

# ── Módulo de Tráfego (painel Meta Ads) ─────────────────────
# Um cliente por linha, no formato  Nome do Cliente = TOKEN
# O nome pode ter acento e espaço; é o que aparece na tela.
# Na Vercel, cole tudo num campo só — ele aceita várias linhas.
#
# Migração prevista (docs/arquitetura/08-integracoes.md): estes tokens
# passam para o cofre de credenciais, e a conta de anúncio vira cadastro
# por tela em vez de variável de ambiente.
META_TOKENS="
Marktiva = EAA...
Casa Carvalho = EAA...
"

# Alíquota de imposto sobre a verba, em porcentagem. Opcional.
# A Meta não devolve imposto na API: o `spend` dela é sempre líquido.
#   META_IMPOSTO=7.65                    (mesma alíquota para todos)
#   META_IMPOSTO=padrao=7.65;Bilumix=9   (padrão + exceções por cliente)
META_IMPOSTO=

# ── Compatibilidade com o painel anterior ───────────────────
# Se você já usava o Painel de Campanhas, cole aqui o DASH_USERS antigo
# antes de rodar o seed: cada conta é migrada com o MESMO hash, e a senha
# de sempre continua valendo. Depois do primeiro seed, pode remover.
DASH_USERS=

# Não é mais usada para sessão (agora é sessão em banco), mas continua
# lida pelo painel de tráfego herdado.
SESSION_SECRET=
