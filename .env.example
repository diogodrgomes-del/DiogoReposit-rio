# ============================================================
# Copie para .env.local no seu computador, e cadastre os mesmos
# valores em Settings -> Environment Variables na Vercel.
#
# NENHUMA destas variáveis chega ao navegador: todas são lidas
# só no servidor. Não use o prefixo NEXT_PUBLIC_ em nenhuma.
# ============================================================

# Um cliente por linha, no formato  Nome do Cliente = TOKEN
# O nome pode ter acento e espaço; é o que aparece na tela.
# Na Vercel, cole tudo num campo só — ele aceita várias linhas.
META_TOKENS="
Marktiva = EAA...
Bom pra home = EAA...
Casa Carvalho = EAA...
Fernanda Luiz = EAA...
Franciele Bill = EAA...
Garagem 3 = EAA...
Kellin Obana = EAA...
Moraes Eletrônicos = EAA...
Óticas Gouveia = EAA...
"

# Chave de assinatura da sessão. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Usuários do painel, separados por vírgula.
# Gere cada entrada com:  npm run senha -- <usuario>
# Formato: usuario:pbkdf2.iteracoes.salt.hash
DASH_USERS=

# ------------------------------------------------------------
# Alternativa para um cliente só (dispensa META_TOKENS):
# META_ACCESS_TOKEN=EAA...
# META_ACCESS_TOKEN_NOME=Marktiva
# ------------------------------------------------------------
