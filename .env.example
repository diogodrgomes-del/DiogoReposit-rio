# ============================================================
# Copie para .env.local no seu computador, e cadastre os mesmos
# valores em Settings -> Environment Variables na Vercel.
#
# NENHUMA destas variáveis chega ao navegador: todas são lidas
# só no servidor. Não use o prefixo NEXT_PUBLIC_ em nenhuma.
# ============================================================

# Um cliente por linha, no formato  Nome do Cliente = TOKEN
# O nome pode ter acento e espaço; é o que aparece na tela.
# Na Vercel, cole tudo num campo só — ele aceita várias linhas.
META_TOKENS="
Marktiva = EAA...
Bom pra home = EAA...
Casa Carvalho = EAA...
Fernanda Luiz = EAA...
Franciele Bill = EAA...
Garagem 3 = EAA...
Kellin Obana = EAA...
Moraes Eletrônicos = EAA...
Óticas Gouveia = EAA...
"

# Chave de assinatura da sessão. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Usuários do painel, separados por vírgula.
# Gere cada entrada com:  npm run senha -- <usuario>
# Formato: usuario:pbkdf2.iteracoes.salt.hash
DASH_USERS=

# Alíquota de imposto sobre a verba, em porcentagem. Opcional.
# A Meta NÃO devolve imposto na API: o `spend` dela é sempre líquido, e os
# endpoints de faturamento não existem mais na v21. O painel calcula sobre a
# alíquota abaixo e rotula como estimativa. Sem esta variável, nenhum valor
# de imposto aparece na tela.
#   META_IMPOSTO=7.65                    (mesma alíquota para todos)
#   META_IMPOSTO=padrao=7.65;Bilumix=9   (padrão + exceções por cliente)
META_IMPOSTO=

# Banco das anotações do registro de testes. Opcional.
# Sem ele o painel funciona: a linha do tempo automática (o que a Meta
# registrou na conta) continua aparecendo, só o campo de escrever fica
# desligado. Aceita qualquer Postgres — na Vercel, crie um Neon em
# Storage e a variável entra sozinha no projeto.
DATABASE_URL=

# ------------------------------------------------------------
# Alternativa para um cliente só (dispensa META_TOKENS):
# META_ACCESS_TOKEN=EAA...
# META_ACCESS_TOKEN_NOME=Marktiva
# ------------------------------------------------------------

# ============================================================
# PORTAL CATIVO DE WI-FI  (página /wifi, login social)
#
# Login por OAuth: a senha é digitada no próprio Facebook/Google,
# nunca na nossa página. Recebemos só nome e e-mail, com consentimento.
# Sem as credenciais abaixo, /wifi funciona em MODO DEMONSTRAÇÃO
# (fluxo completo com visitante fictício, para ver a tela).
# ============================================================

# Nome do lugar mostrado no topo da página (ex.: Café Central).
PORTAL_NEGOCIO=

# URL pública do portal, sem barra no fim (ex.: https://wifi.seucafe.com.br).
# Precisa bater EXATAMENTE com o redirect_uri cadastrado no Facebook/Google.
# Sem ela, o portal deduz o endereço pelos cabeçalhos da requisição.
PORTAL_URL_BASE=

# Facebook Login — em developers.facebook.com, crie um app, produto
# "Login do Facebook", e cadastre o redirect_uri:
#   {PORTAL_URL_BASE}/api/wifi/facebook/callback
PORTAL_FACEBOOK_APP_ID=
PORTAL_FACEBOOK_SECRET=

# Google — em console.cloud.google.com, credencial OAuth 2.0 "Web",
# com URI de redirecionamento autorizado:
#   {PORTAL_URL_BASE}/api/wifi/google/callback
PORTAL_GOOGLE_CLIENT_ID=
PORTAL_GOOGLE_SECRET=

# Página do negócio no Facebook, para o botão de check-in voluntário
# na tela de "conectado". Opcional.
PORTAL_FACEBOOK_PAGE=

# Para onde mandar o visitante depois de conectar (cardápio, site…). Opcional.
PORTAL_URL_DESTINO=

# Roteador com portal cativo (CoovaChilli/UAM): quando o AP manda os
# parâmetros uamip/uamport, o portal libera sozinho. Para outros modelos,
# um endereço de liberação com {ip}/{mac} trocados pelos dados do cliente.
# Opcional — sem isso, cai na tela de "conectado" após o login.
PORTAL_LIBERAR_URL=
