# ============================================================
# Copie para .env.local no seu computador, e cadastre os mesmos
# valores em Settings -> Environment Variables na Vercel.
#
# NENHUMA destas variáveis chega ao navegador: todas são lidas
# só no servidor. Não use o prefixo NEXT_PUBLIC_ em nenhuma.
# ============================================================

# Um cliente por linha, no formato  Nome do Cliente = TOKEN
# O nome pode ter acento e espaço; é o que aparece na tela.
# Na Vercel, cole tudo num campo só — ele aceita várias linhas.
META_TOKENS="
Marktiva = EAA...
Bom pra home = EAA...
Casa Carvalho = EAA...
Fernanda Luiz = EAA...
Franciele Bill = EAA...
Garagem 3 = EAA...
Kellin Obana = EAA...
Moraes Eletrônicos = EAA...
Óticas Gouveia = EAA...
"

# Chave de assinatura da sessão. Gere uma nova com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Usuários do painel, separados por vírgula.
# Gere cada entrada com:  npm run senha -- <usuario>
# Formato: usuario:pbkdf2.iteracoes.salt.hash
DASH_USERS=

# Alíquota de imposto sobre a verba, em porcentagem. Opcional.
# A Meta NÃO devolve imposto na API: o `spend` dela é sempre líquido, e os
# endpoints de faturamento não existem mais na v21. O painel calcula sobre a
# alíquota abaixo e rotula como estimativa. Sem esta variável, nenhum valor
# de imposto aparece na tela.
#   META_IMPOSTO=7.65                    (mesma alíquota para todos)
#   META_IMPOSTO=padrao=7.65;Bilumix=9   (padrão + exceções por cliente)
META_IMPOSTO=

# Banco das anotações do registro de testes. Opcional.
# Sem ele o painel funciona: a linha do tempo automática (o que a Meta
# registrou na conta) continua aparecendo, só o campo de escrever fica
# desligado. Aceita qualquer Postgres — na Vercel, crie um Neon em
# Storage e a variável entra sozinha no projeto.
DATABASE_URL=

# ------------------------------------------------------------
# Alternativa para um cliente só (dispensa META_TOKENS):
# META_ACCESS_TOKEN=EAA...
# META_ACCESS_TOKEN_NOME=Marktiva
# ------------------------------------------------------------

# ============================================================
# MARK SISTEM — a partir da fase 0
# ============================================================

# Postgres do sistema. Na Vercel: Storage -> Create -> Neon, e a variável entra
# sozinha. Aceita qualquer Postgres; o driver é escolhido pela URL.
#
# O papel usado aqui NÃO pode ser superusuário nem ter BYPASSRLS: os dois
# ignoram Row Level Security, e o isolamento entre organizações vira enfeite.
# O papel padrão da Neon já atende.
# DATABASE_URL=postgresql://...

# Só para o seed não interativo (CI, provisionamento). Em uso normal o
# `npm run db:semear` pergunta tudo, e a senha nunca vem por variável de
# ambiente — variável vaza para o histórico do shell e para a lista de processos.
# SEED_ORG=Marktiva
# SEED_SLUG=marktiva
# SEED_NOME=Diogo
# SEED_EMAIL=

# Chaves mestras do cofre, que cifram token da Meta e senhas dos clientes.
# Formato: versao:chave,versao:chave — várias ao mesmo tempo só durante uma
# rotação, quando a nova cifra e as antigas ainda decifram.
#
#   node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64url'))"
#
# GUARDE UMA CÓPIA OFFLINE. Perder esta chave torna todas as senhas de todos
# os clientes irrecuperáveis — não há como reconstruí-las a partir do banco.
# COFRE_KEKS=
# COFRE_KEK_ATUAL=1
